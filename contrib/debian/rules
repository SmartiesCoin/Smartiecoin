#!/usr/bin/make -f
# -*- mode: makefile; coding: utf-8 -*-

#DEB_MAKE_CHECK_TARGET = test_SMT
#build/smartiecoind::
#	$(if $(filter nocheck,$(DEB_BUILD_OPTIONS)),,src/test_SMT)

%:
	dh --with bash-completion $@

override_dh_auto_clean:
	if [ -f Makefile ]; then $(MAKE) distclean; fi
	rm -rf Makefile.in aclocal.m4 configure src/Makefile.in src/bitcoin-config.h.in src/build-aux src/qt/Makefile.in src/qt/test/Makefile.in src/test/Makefile.in

QT=$(shell dpkg-vendor --derives-from Ubuntu && echo qt4 || echo qt5)

# Yea, autogen should be run on the source archive, but I like doing git archive
override_dh_auto_configure:
	./autogen.sh
	./configure --with-gui=$(QT)

override_dh_auto_test:
	make check

# Gate the packages on the release BDB policy: the wallet must link exactly the pinned
# Berkeley DB 4.8.30 and no shipped binary may depend on a dynamic BDB library (see
# test/lint/test_release_bdb_artifacts.py).
override_dh_builddeb:
	python3 contrib/devtools/check-release-bdb.py --runtime required \
	  --config-header $(CURDIR)/src/config/bitcoin-config.h \
	  --wallet $(CURDIR)/src/smartiecoin-wallet \
	  --node $(CURDIR)/src/smartiecoind --node $(CURDIR)/src/qt/smartiecoin-qt
	dh_builddeb


